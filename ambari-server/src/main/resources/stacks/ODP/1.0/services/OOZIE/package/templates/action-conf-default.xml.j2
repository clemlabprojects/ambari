<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Managed by Ambari. Defaults that Oozie injects into the configuration of every action it submits
  (oozie.service.HadoopAccessorService.action.configurations = *=action-conf); the oozie.launcher.*
  entries also reach the launcher ApplicationMaster configuration. Per-action files (<action>.xml)
  override these values; workflow <configuration> entries override both.
-->
<configuration>
  <!--
    mapred-site and yarn-site refer to the stack version through ${{ '{' }}{{oozie_stack_version_property}}{{ '}' }}
    (framework path, application classpath, admin JVM options). Hadoop clients resolve it from the
    -D{{oozie_stack_version_property}} system property set by the stack wrappers; the Oozie server and its
    launchers do not run with it, so define it as a configuration property for every action.
  -->
  <property>
    <name>{{oozie_stack_version_property}}</name>
    <value>{{oozie_stack_version}}</value>
  </property>
  <!-- Only oozie.launcher.* entries reach the launcher ApplicationMaster configuration, which
       inherits the same ${{ '{' }}{{oozie_stack_version_property}}{{ '}' }} placeholders from mapred-site and yarn-site. -->
  <property>
    <name>oozie.launcher.{{oozie_stack_version_property}}</name>
    <value>{{oozie_stack_version}}</value>
  </property>
{% if oozie_launcher_framework_archive %}
  <!--
    The Oozie launcher is a plain YARN ApplicationMaster. Hadoop localizes
    mapreduce.application.framework.path only for MapReduce jobs, while the launcher classpath built
    from mapreduce.application.classpath expects the framework archive under $PWD. Localize it for
    the launcher so MapReduce, Java, Hive2, Sqoop and DistCp actions can load the MapReduce classes.
  -->
  <property>
    <name>oozie.launcher.mapreduce.job.cache.archives</name>
    <value>{{oozie_launcher_framework_archive}}</value>
  </property>
{% endif %}
</configuration>
