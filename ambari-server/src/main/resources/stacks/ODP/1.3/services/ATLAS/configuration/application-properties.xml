<configuration supports_final="false">
  <!-- Atlas 2.2+ defaults this JanusGraph option to false (ATLAS-4340) and the Atlas solrconfig keeps
       autoSoftCommit disabled, so without an explicit commit new entities are never visible to the
       Solr-backed basic/quick/free-text search until a core reload (dev11 finding, 2026-10-04). -->
  <property>
    <name>atlas.graph.index.search.solr.wait-searcher</name>
    <display-name>atlas.graph.index.search.solr.wait-searcher</display-name>
    <value>true</value>
    <description>Commit JanusGraph index mutations to Solr and wait for the new searcher, so entities become searchable as soon as they are created or updated. Atlas defaults to false, which requires Solr autoSoftCommit to be configured instead.</description>
    <value-attributes>
      <type>boolean</type>
    </value-attributes>
    <on-ambari-upgrade add="true"/>
  </property>
</configuration>
