{
  "services": [
    {
      "name": "KUDU",
      "configurations": [
        {
          "ranger-kudu-audit": {
            "xasecure.audit.jaas.Client.loginModuleName": "com.sun.security.auth.module.Krb5LoginModule",
            "xasecure.audit.jaas.Client.loginModuleControlFlag": "required",
            "xasecure.audit.jaas.Client.option.useKeyTab": "true",
            "xasecure.audit.jaas.Client.option.storeKey": "false",
            "xasecure.audit.jaas.Client.option.serviceName": "solr",
            "xasecure.audit.destination.solr.force.use.inmemory.jaas.config": "true"
          }
        }
      ],
      "components": [
        {
          "name": "KUDU_MASTER",
          "identities": [
            {
              "name": "kudu_master_service",
              "principal": {
                "value": "${kudu-env/kudu_user}/_HOST@${realm}",
                "type": "service",
                "configuration": "kudu-env/kudu_principal_name"
              },
              "keytab": {
                "file": "${keytab_dir}/kudu.service.keytab",
                "owner": {
                  "name": "${kudu-env/kudu_user}",
                  "access": "r"
                },
                "group": {
                  "name": "${kudu-env/kudu_group}",
                  "access": ""
                },
                "configuration": "kudu-env/kudu_keytab"
              }
            },
            {
              "name": "ranger_kudu_audit",
              "reference": "/KUDU/KUDU_MASTER/kudu_master_service",
              "principal": {
                "configuration": "ranger-kudu-audit/xasecure.audit.jaas.Client.option.principal"
              },
              "keytab": {
                "configuration": "ranger-kudu-audit/xasecure.audit.jaas.Client.option.keyTab"
              }
            },
            {
              "name": "kudu_master_http",
              "principal": {
                "value": "HTTP/_HOST@${realm}",
                "type": "service"
              },
              "keytab": {
                "file": "${keytab_dir}/kudu.service.keytab",
                "owner": {
                  "name": "${kudu-env/kudu_user}",
                  "access": "r"
                },
                "group": {
                  "name": "${kudu-env/kudu_group}",
                  "access": ""
                }
              }
            }
          ]
        },
        {
          "name": "KUDU_TSERVER",
          "identities": [
            {
              "name": "kudu_tserver_service",
              "principal": {
                "value": "${kudu-env/kudu_user}/_HOST@${realm}",
                "type": "service",
                "configuration": "kudu-env/kudu_principal_name"
              },
              "keytab": {
                "file": "${keytab_dir}/kudu.service.keytab",
                "owner": {
                  "name": "${kudu-env/kudu_user}",
                  "access": "r"
                },
                "group": {
                  "name": "${kudu-env/kudu_group}",
                  "access": ""
                },
                "configuration": "kudu-env/kudu_keytab"
              }
            },
            {
              "name": "kudu_tserver_http",
              "principal": {
                "value": "HTTP/_HOST@${realm}",
                "type": "service"
              },
              "keytab": {
                "file": "${keytab_dir}/kudu.service.keytab",
                "owner": {
                  "name": "${kudu-env/kudu_user}",
                  "access": "r"
                },
                "group": {
                  "name": "${kudu-env/kudu_group}",
                  "access": ""
                }
              }
            }
          ]
        },
        {
          "name": "KUDU_CLIENT",
          "identities": [
            {
              "name": "kudu_smokeuser",
              "reference": "/smokeuser"
            }
          ]
        }
      ]
    }
  ]
}
