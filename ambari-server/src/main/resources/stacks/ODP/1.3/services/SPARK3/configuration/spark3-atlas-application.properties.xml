<configuration supports_final="false">
  <!-- Spark jobs run as the end user, who has no publish right on ATLAS_HOOK. The Atlas service creates
       the ATLAS_SPARK_HOOK topic and opens it to all users, so the Spark hook must publish there. -->
  <property>
    <name>atlas.notification.hook.topic.name</name>
    <value>ATLAS_SPARK_HOOK</value>
    <description>Kafka topic the Spark Atlas hook publishes to. Atlas must consume it, see atlas.notification.hook.consumer.topic.names in the Atlas application properties.</description>
    <on-ambari-upgrade add="true"/>
  </property>
</configuration>
