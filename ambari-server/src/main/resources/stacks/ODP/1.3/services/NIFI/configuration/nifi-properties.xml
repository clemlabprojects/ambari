<!-- Defaults shared by NiFi 1.28 (ODP 1.3.1.0) and NiFi 2.8 (ODP 1.3.2.0): both are Apache NiFi's own defaults.
     Existing clusters keep their configured values. -->
<configuration supports_final="false">
  <property>
    <name>nifi.sensitive.props.algorithm</name>
    <value>NIFI_PBKDF2_AES_GCM_256</value>
    <on-ambari-upgrade add="true"/>
    <description>The algorithm used to encrypt sensitive properties. NiFi 2.x supports only NIFI_PBKDF2_AES_GCM_256 (default) and NIFI_ARGON2_AES_GCM_256; both require a sensitive properties key of at least 12 characters.</description>
  </property>
  <property>
    <name>nifi.provenance.repository.implementation</name>
    <value>org.apache.nifi.provenance.WriteAheadProvenanceRepository</value>
    <on-ambari-upgrade add="true"/>
    <description>The Provenance Repository implementation. NiFi 2.x removed org.apache.nifi.provenance.PersistentProvenanceRepository; the WriteAheadProvenanceRepository reads data written by it.</description>
  </property>
</configuration>
