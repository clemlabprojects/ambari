<!-- Keep the H2 database in the managed database directory instead of the versioned install directory. -->
<configuration>
    <property>
        <name>nifi.registry.db.url</name>
        <value>jdbc:h2:{{nifi_registry_database_dir}}/nifi-registry-primary;AUTOCOMMIT=OFF;DB_CLOSE_ON_EXIT=FALSE;LOCK_MODE=3;LOCK_TIMEOUT=25000;WRITE_DELAY=0;AUTO_SERVER=FALSE</value>
        <on-ambari-upgrade add="true"/>
        <description>The JDBC URL of the NiFi Registry database. The default H2 database lives in the NiFi Registry database directory.</description>
    </property>
</configuration>
