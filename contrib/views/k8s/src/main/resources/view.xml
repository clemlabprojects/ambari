<view>
    <name>K8S-VIEW</name>
    <label>Ambari K8S View</label>
    <version>1.0.0.9</version>
    <build>${env.BUILD_NUMBER}</build>
    <min-ambari-version>2.5.0</min-ambari-version>
    <!--
      Data migration across view versions. Ambari runs data-migrator-class once, on the first start of a
      new version, when the previous version's instance of the same name is still extracted under
      views/work. It is only used when data-version differs from the previous version's value, otherwise
      Ambari falls back to a generic copy that loses BeanInfo-hidden fields (release Git metadata).
      Keep data-version equal to the last number of <version>; ViewXmlMigrationContractTest enforces it.
    -->
    <data-version>9</data-version>
    <data-migrator-class>org.apache.ambari.view.k8s.migration.KdpsDataMigrator</data-migrator-class>

    <description>Une vue Ambari pour interagir avec un cluster Kubernetes.</description>
    
    <!--
      Déclaration de notre service REST. Le nom 'api' sera utilisé dans l'URL.
      Exemple: /api/v1/views/K8S_VIEW/versions/1.0.0.0/instances/K8S_VIEW_INSTANCE/resources/api/cluster/stats
    -->
    <resource>
        <name>api</name>
        <service-class>org.apache.ambari.view.k8s.KubeService</service-class>
    </resource>
    
    <system-services>
        <service>
          <class>org.glassfish.jersey.media.multipart.MultiPartFeature</class>
        </service>
        <service>
          <class>org.apache.ambari.view.k8s.service.GsonConfigurator</class>
        </service>
        <service>
          <class>org.apache.ambari.view.k8s.resources.ArgoResource</class>
        </service>
    </system-services>
    <parameter>
        <name>k8s.view.working.dir</name>
        <description>
          Répertoire sur le serveur Ambari où la vue stocke ses fichiers de configuration
          (kubeconfig, repos Helm, registre OCI). NE PAS définir explicitement sauf besoin
          d'override — laisser ce paramètre vide pour que le service utilise
          /var/lib/ambari-server/resources/views/k8s-view-data/&lt;instanceName&gt;, chemin
          persistant qui survit aux redéploiements de la vue (AMBARI-426). Une valeur
          explicite pointant vers /var/lib/ambari-server/resources/views/work/...
          serait perdue à chaque redéploiement du JAR — voir
          ViewConfigurationService.defaultWorkDir().
        </description>
        <label>Répertoire de Travail (optionnel)</label>
        <required>false</required>
    </parameter>
    <parameter>
        <name>ambari.cluster.discovery.enabled</name>
        <description>Auto discovery of existing cluster from ambari-server.</description>
        <label>Cluster Auto Discovery</label>
        <required>false</required>
        <default-value>true</default-value>
    </parameter>
    <parameter>
        <name>view.admin.users</name>
        <description>Comma-separated list of Ambari usernames with the KDPS admin role: they configure the view (kubeconfig, platform contexts, Helm repositories, security profiles, truststores, managed configurations) and can also do everything an operator does. When left empty, only Ambari administrators have the admin role.</description>
        <label>View Admin Users</label>
        <required>false</required>
    </parameter>
    <parameter>
        <name>view.operator.users</name>
        <description>Comma-separated list of Ambari usernames with the KDPS operator role: they deploy, upgrade, roll back and uninstall releases and restart or delete their pods, but cannot change the view configuration. Every other user granted access to the view instance is read-only. The Ambari account of the view's own keytab webhook (webhook-user by default) does not need to be listed: it can still request pod keytabs in the WEBHOOK Kerberos injection mode.</description>
        <label>View Operator Users</label>
        <required>false</required>
    </parameter>
    <parameter>
        <name>k8s.view.allowed.namespaces</name>
        <description>Optional comma-separated list of the Kubernetes namespaces where the view may write Opaque Secrets (keytabs, generated credentials, managed configurations) and read or delete managed configurations. When left empty, every namespace the view's Kubernetes account can reach is allowed.</description>
        <label>Allowed Namespaces</label>
        <required>false</required>
    </parameter>
    <!--
      NOTE: the Vault address/token view parameters were intentionally removed. A `<masked>`
      parameter that has no value makes Ambari's ViewContextImpl.getProperties() call
      DefaultMasker.unmask(null) → `new String(Base64.decodeBase64(null))` → NullPointerException,
      and that NPE is uncaught (the framework only catches MaskException), so EVERY view endpoint
      that reads properties (e.g. /commands) 500s. The backend (CommandService.writeOidcToVault)
      still reads k8s.view.vault.address/token from the view context and is a no-op when they are
      absent, so Vault writes simply stay disabled. Re-introduce these via a secret mechanism that
      does not depend on an unset masked parameter when Vault-backed secret storage is wired for real.
    -->

    <persistence>
        <!-- Fully qualified name of your @Entity class -->
        <entity>
          <class>org.apache.ambari.view.k8s.store.HelmRepoEntity</class>
          <id-property>id</id-property>
        </entity>
        <entity>
          <class>org.apache.ambari.view.k8s.store.K8sReleaseEntity</class>
          <id-property>id</id-property>
        </entity>
        <entity>
          <class>org.apache.ambari.view.k8s.store.CommandStatusEntity</class>
          <id-property>id</id-property>
        </entity>
        <entity>
            <class>org.apache.ambari.view.k8s.store.CommandEntity</class>
            <id-property>id</id-property>
        </entity>
        <entity>
            <class>org.apache.ambari.view.k8s.store.SecurityProfileEntity</class>
            <id-property>id</id-property>
        </entity>
        <entity>
            <class>org.apache.ambari.view.k8s.store.SecurityMappingEntity</class>
            <id-property>id</id-property>
        </entity>
        <entity>
            <class>org.apache.ambari.view.k8s.store.KdpsContextEntity</class>
            <id-property>id</id-property>
        </entity>
        <entity>
            <class>org.apache.ambari.view.k8s.store.TrinoCatalogEntity</class>
            <id-property>id</id-property>
        </entity>
        <!-- Instance-wide settings shared by every user (cluster connection, repository and context secrets). -->
        <entity>
            <class>org.apache.ambari.view.k8s.store.KdpsSettingEntity</class>
            <id-property>id</id-property>
        </entity>
        <!-- If more entities are added later, list them here as well -->
        <!-- <entity class="org.apache.ambari.view.k8s.store.OtherEntity"/> -->
    </persistence>
    <!--
      Définition d'une instance par défaut.
      Contrairement à la vue Capacity Scheduler, nous n'utilisons pas <auto-instance>
      car notre vue ne dépend pas d'un service géré par Ambari (comme YARN).
      Une création manuelle est plus appropriée.
    -->
    <instance>
        <name>K8S_VIEW_INSTANCE</name>
        <label>Kubernetes Cluster Manager</label>
        <description>Instance par défaut pour la vue Kubernetes</description>
        <visible>true</visible>
        <public>false</public>
        <!--
          No <roles> here: Ambari applies view roles only to an <auto-instance>, so a list on this instance
          would be ignored. An Ambari administrator grants the instance to users, and the KDPS role of each
          user comes from view.admin.users and view.operator.users.
        -->
    </instance>
    
</view>
