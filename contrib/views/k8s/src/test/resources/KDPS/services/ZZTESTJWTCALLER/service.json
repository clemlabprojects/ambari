{
  "label": "ZZ Test JWT caller (calls a KDPS Trino with its own OIDC service token, NOT in catalog.json)",
  "chart": "example/zz-test-jwt-caller",
  "version": "0.0.1",
  "form": [],
  "oidc": [
    {
      "key": "caller",
      "clientIdTemplate": "{{releaseName}}-{{namespace}}",
      "secretNameTemplate": "{{releaseName}}-oidc-client",
